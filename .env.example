# RADIO MERCADO DON MANUEL — configuración (copie este archivo como .env y complete los valores)
# NUNCA suba el archivo .env a GitHub: contiene la contraseña del administrador.

# --- Servidor ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Dirección pública con HTTPS (se usa para mostrar los enlaces de las sedes en el panel)
PUBLIC_BASE_URL=https://radio.su-dominio.com
# true cuando hay un proxy HTTPS delante (Caddy en docker-compose)
TRUST_PROXY=true
COOKIE_SECURE=true
TIMEZONE=America/Bogota

# --- Datos (base de datos, comerciales, música, señal en vivo) ---
DATA_DIR=./data
BACKUP_DIR=./data/backups

# --- Primer administrador (solo se usa si todavía no existe ninguno) ---
# Mínimo 10 caracteres, con letras y números. Después puede cambiarla desde el panel (Cuenta).
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- FFmpeg (en Windows, ruta completa si no está en el PATH) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# FONT_FILE=C:/Windows/Fonts/arialbd.ttf

# --- Calidad de la señal (todas las sedes reciben la misma) ---
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE_KBPS=1800
AUDIO_BITRATE_KBPS=128
# copy = bajo consumo de CPU (recomendado); encode = recodifica el video de las canciones
RENDER_MODE=copy

# --- HLS y sincronización ---
HLS_SEGMENT_SECONDS=4
HLS_WINDOW_SEGMENTS=8
# Retraso común objetivo (ms) entre la hora oficial de emisión y lo que suena en cada televisor
SYNC_TARGET_DELAY_MS=18000

# --- Reproductores de las sedes ---
PLAYER_HEARTBEAT_SECONDS=5
SITE_OFFLINE_AFTER_SECONDS=30
PLAYER_BACKUP_DOWNLOAD_DELAY_SECONDS=60
PLAYER_BACKUP_AFTER_SECONDS=20

# --- Límites ---
MAX_AD_UPLOAD_MB=2048
MAX_MUSIC_UPLOAD_MB=60
PUBLIC_RATE_PER_MINUTE=600
SESSION_HOURS=12

# --- Almacenamiento permanente (opcional, recomendado en Render gratis) ---
# Supabase → Project Settings → API. La service_role key es SECRETA: póngala solo aquí o en Render, nunca en el código.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=radio-mercado
